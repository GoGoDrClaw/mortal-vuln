# VulnNotes CTF Configuration

# Base domain — all services run as subdomains:
#   {DOMAIN}              → Frontend
#   api.{DOMAIN}          → API + WebSocket
#   dashboard.{DOMAIN}    → Scoreboard
#   evil.{DOMAIN}         → Evil site (CSRF)
#
# For LAN/remote: set to your server IP or domain
DOMAIN=ctf.local

# JWT Secret — change this before running!
JWT_SECRET=secret123

# Number of teams (2–22)
TEAM_COUNT=6

# Add to /etc/hosts for local access:
# 127.0.0.1 ctf.local api.ctf.local dashboard.ctf.local evil.ctf.local

# --- Scheduled Reset ---
# Auto-reset all team progress + databases at a fixed time each day.
# RESET_TIME format: HH:MM (24h). Leave blank to disable.
RESET_TIME=
# RESET_TIMEZONE=Europe/Moscow
RESET_TIMEZONE=UTC

# --- Rate Limiting ---
# Token-bucket rate limiter per IP (applied to all endpoints).
# Set RATE_LIMIT_DISABLED=1 to turn off entirely.
RATE_LIMIT_RPS=20
RATE_LIMIT_BURST=40
# RATE_LIMIT_DISABLED=1
