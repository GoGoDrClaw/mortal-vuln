# VulnNotes CTF Configuration

# Base domain — all services run as subdomains:
#   {DOMAIN}              → Frontend
#   api.{DOMAIN}          → API + WebSocket
#   dashboard.{DOMAIN}    → Scoreboard
#   evil.{DOMAIN}         → Evil site (CSRF)
DOMAIN=ctf.local

# JWT Secret — change before running!
JWT_SECRET=secret123

# PostgreSQL password
POSTGRES_PASSWORD=ctfpassword

# --- Rate Limiting ---
# Token-bucket rate limiter per IP (all endpoints). Set RATE_LIMIT_DISABLED=1 to turn off.
RATE_LIMIT_RPS=20
RATE_LIMIT_BURST=40
# RATE_LIMIT_DISABLED=1

# Add to /etc/hosts for local access:
# 127.0.0.1 ctf.local api.ctf.local dashboard.ctf.local evil.ctf.local
